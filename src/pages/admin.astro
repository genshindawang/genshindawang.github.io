---
import MainGridLayout from "../layouts/MainGridLayout.astro";
import { newPaperUrl, paperEditorUrl, writerUrl } from "../data/notebook";
import { papers, sourceFile, STATUS } from "../lib/papers";
const recent = (await papers()).slice(0, 6);
---
<MainGridLayout title="写作空间">
  <section class="card-base p-6 md:p-9 mb-4">
    <p class="text-sm text-[var(--primary)] font-bold mb-3">DINNER · WRITING ROOM</p>
    <h1 class="text-3xl font-bold text-90">写下这次读懂的东西。</h1>
    <div class="flex flex-wrap gap-3 mt-6">
      <a href={newPaperUrl()} target="_blank" rel="noopener noreferrer" class="btn-regular rounded-xl px-5 h-12 font-bold">+ 写一篇新笔记 ↗</a>
      <a href={writerUrl()} target="_blank" rel="noopener noreferrer" class="btn-plain rounded-xl px-5 h-12">管理所有论文 ↗</a>
    </div>
  </section>
  <section class="card-base p-6 md:p-9 mb-4">
    <div class="flex items-baseline justify-between gap-3 mb-3"><h2 class="text-xl font-bold text-90">接着写</h2><a href={writerUrl()} target="_blank" rel="noopener noreferrer" class="text-sm text-[var(--primary)]">全部笔记 ↗</a></div>
    <div class="divide-y divide-black/5 dark:divide-white/10">{recent.map(paper => <a href={paperEditorUrl(sourceFile(paper))} target="_blank" rel="noopener noreferrer" class="flex flex-col sm:flex-row sm:items-center gap-2 py-4 hover:text-[var(--primary)]"><span class="flex-1 text-75 font-medium">{paper.data.title}</span><span class="text-sm text-50">{STATUS[paper.data.status]} · 编辑 ↗</span></a>)}</div>
    {!recent.length && <p class="text-50">暂无笔记</p>}
  </section>
</MainGridLayout>
