---
import MainGridLayout from "../../layouts/MainGridLayout.astro";
import { papers, topics, topicUrl, paperUrl, STATUS } from "../../lib/papers";
const entries=await papers();
---
<MainGridLayout title="论文分类"><section class="card-base p-6 md:p-9"><h1 class="text-2xl font-bold text-90 mb-3">论文分类</h1><p class="text-50 mb-8">沿着一个研究方向，把读过和准备读的论文串起来。</p>{topics(entries).map(topic=><section class="mb-8 last:mb-0"><div class="flex items-center gap-3 mb-3"><span class="h-5 w-1 rounded bg-[var(--primary)]"></span><a href={topicUrl(topic)} class="font-bold text-xl text-90 hover:text-[var(--primary)]">{topic}</a><span class="text-sm text-50">{entries.filter(p=>(p.data.category||"未分类")===topic).length}</span></div><ul class="ml-4 border-l border-dashed border-black/10 dark:border-white/15 pl-5 space-y-1">{entries.filter(p=>(p.data.category||"未分类")===topic).map(p=><li><a href={paperUrl(p)} class="btn-plain py-3 px-3 rounded-lg !justify-between gap-3"><span>{p.data.title}</span><span class="text-50 text-sm shrink-0">{STATUS[p.data.status]}</span></a></li>)}</ul></section>)}</section></MainGridLayout>
