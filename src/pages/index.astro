---
import MainGridLayout from "../layouts/MainGridLayout.astro";
import PaperCard from "../components/notebook/PaperCard.astro";
import { papers } from "../lib/papers";
import { newPaperUrl } from "../data/notebook";
import { url } from "../utils/url-utils";
const entries = (await papers()).filter(p=>p.data.status !== "queue");
---
<MainGridLayout>
  <section class="card-base p-6 md:px-9 mb-4">
    <div class="flex items-center justify-between gap-4 flex-wrap"><h1 class="text-2xl font-bold text-90">论文笔记</h1><a class="btn-regular rounded-lg px-4 h-10 text-sm" href={newPaperUrl()} target="_blank" rel="noopener noreferrer">+ 写笔记</a></div>
    <form action={url("/search/")} method="get" class="mt-4 xl:hidden"><input class="notebook-search !w-full" type="search" name="q" aria-label="搜索论文和笔记" placeholder="搜索论文和笔记" /></form>
    <div class="flex gap-5 text-sm mt-5 text-50" aria-label="阅读状态筛选"><a data-status-filter="" href={url("/")} class="hover:text-[var(--primary)]">全部</a><a data-status-filter="reading" href={url("/?status=reading")} class="hover:text-[var(--primary)]">正在读</a><a data-status-filter="finished" href={url("/?status=finished")} class="hover:text-[var(--primary)]">已读完</a></div>
  </section>
  <div class="flex flex-col gap-4">{entries.map(paper=><PaperCard paper={paper} />)}</div>
  <div id="empty-state" hidden class="card-base p-10 text-center text-50">还没有这个状态的论文笔记。</div>
</MainGridLayout>
<script>
function filter() {
  const requested = new URLSearchParams(location.search).get("status") ?? "";
  const status = ["reading","finished"].includes(requested) ? requested : "";
  let visible=0;
  document.querySelectorAll<HTMLElement>("[data-paper-card]").forEach(card=>{card.hidden=!!status&&card.dataset.status!==status;if(!card.hidden)visible++;});
  document.querySelectorAll<HTMLElement>("[data-status-filter]").forEach(link=>{link.classList.toggle("text-[var(--primary)]",link.dataset.statusFilter===status);link.classList.toggle("font-bold",link.dataset.statusFilter===status);});
  const empty=document.getElementById("empty-state");if(empty)empty.hidden=visible>0;
}
filter();
</script>
