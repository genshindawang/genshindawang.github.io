---
import MainGridLayout from "../layouts/MainGridLayout.astro";
import PaperCard from "../components/notebook/PaperCard.astro";
import { papers } from "../lib/papers";
import { newPaperUrl } from "../data/notebook";
const entries = (await papers()).filter(p=>p.data.status === "queue");
---
<MainGridLayout title="待读清单">
  <section class="card-base p-6 md:px-9 mb-4"><div class="flex items-center justify-between gap-4 flex-wrap"><h1 class="text-2xl font-bold text-90">待读清单</h1><a class="btn-regular rounded-lg px-4 h-10 text-sm" href={newPaperUrl()} target="_blank" rel="noopener noreferrer">+ 加入待读</a></div><p class="text-50 mt-2">把感兴趣的论文先放在这里，留一点时间慢慢读。添加时在后台将阅读状态选为「待读」即可。</p></section>
  <div class="flex flex-col gap-4">{entries.map(paper=><PaperCard paper={paper} />)}</div>
  {!entries.length&&<div class="card-base p-10 text-center text-50">待读清单是空的。</div>}
</MainGridLayout>
